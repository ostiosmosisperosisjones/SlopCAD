# Build environment for the Linux AppImage — same userland as CI
# (ubuntu-24.04), so the AppImage runs on anything with glibc >= 2.39.
# build-essential: python-solvespace ships no Linux wheel and compiles (the
# GitHub runner image has gcc preinstalled).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12 python3.12-venv python3.12-dev python3-pip build-essential \
      curl ca-certificates file \
      libgl1 libglu1-mesa libegl1 libglib2.0-0 libdbus-1-3 libfontconfig1 \
      libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 \
      libxcb-xinerama0 libxcb-xkb1 libxkbcommon-x11-0 libxrender1 libxi6 \
      xvfb xauth libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
